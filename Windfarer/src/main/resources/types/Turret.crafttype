      forbidden:
        - "minecraft:bedrock"
    can_switch_world: false
    can_be_named: true
    rotate_at_midpoint: false
    merge_piston_extensions: true
    release_timeout: 1000
  movement:
    #chest_penalty:
    speed:
      speed: 1.0
    cruise:
      enabled: false
    collision:
      sound:
        ==: Movecraft_ConfiguredSound
        Sound: "block.anvil.land"
        Category: "NEUTRAL"
        MinVolume: 2.0
        MaxVolume: 2.0
        MinPitch: 1.0
        MaxPitch: 1.0
    can_direct_control: false
    entities:
      enabled: false
  constraints:
    size:
      max: 2500
      min: 1
    allow_remote_sign: true
    must_be_subcraft: false
    movement:
      can_fly: true
      #TODO: Add proper turret base blocks?
      #required_contact_blocks:
      #traction_blocks:
      allow_vertical: false
      allow_horizontal: false
      static_move:
        enabled: false
      height_limit:
        max: 144
    block:
      flyblocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Super armor"
          min: 0.0
          max: 25.0
          blocks:
            - "minecraft:obsidian"
      detection_blocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Super armor"
          min: 0.0
          max: 25.0
          blocks:
            - "minecraft:obsidian"
      move_blocks:
  try_nudge: false
  fuel:
    burn_rate: 0.0
  sinking:
    #Old sinkpercent!
    constraint_intolerance: 100.0
    explosion:
      strength: 2.0
movecraft-bridges:
  allow_bridge_signs: false
movecraft-combat:
  #Directors
  allow_aa_director_sign: true
  allow_arrow_director_sign: true
  allow_cannon_director_sign: true